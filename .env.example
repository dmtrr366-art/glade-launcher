# Порт сервера
PORT=3000

# Настройки реальной почты SMTP (опционально).
# Если не указаны, код подтверждения выводится в консоль сервера и в плавающий пуш лаунчера.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=your-email@yandex.ru
# SMTP_PASS=your-app-password
# SMTP_FROM="HopliteX Launcher" <your-email@yandex.ru>
